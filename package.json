{
  "name": "strellis",
  "private": true,
  "workspaces": [
    "editor",
    "scripts/*"
  ],
  "scripts": {
    "editor:dev": "bun run --filter editor dev",
    "editor:build": "bun run --filter editor build",
    "editor:preview": "bun run --filter editor preview",
    "editor:add": "bun add --cwd editor",
    "generate-templates:run": "bun run --filter generate-template run",
    "generate-templates:add": "bun add --cwd scripts/generate-template"
  }
}
